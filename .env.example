# Copy to .env (which is gitignored) and fill in. Never commit .env.

# Required for the router and hero agents. Without it only instant-path orders work.
ANTHROPIC_API_KEY=

# Voice orders via OpenAI's realtime transcription (gpt-live-transcribe). Without it the game uses the
# browser's built-in speech recognition.
OPENAI_API_KEY=

# Optional
# OPENAI_STT_MODEL=gpt-live-transcribe
# OPENAI_STT_DELAY=low          # minimal | low | medium | high | xhigh: lower is faster, higher can be more accurate
# OPENAI_REALTIME_URL=wss://api.openai.com/v1/realtime?intent=transcription
# ANTHROPIC_MODEL=claude-haiku-5-5
# ANTHROPIC_EFFORT=low          # low | medium | high
# LLM_MAX_TOKENS=2000
# HOST=127.0.0.1
# PORT=8787
# LOG_LEVEL=info                # debug also logs every prompt and reply
# LOG_PROMPTS=false             # true logs prompts and replies at info level
# LOG_DIR=logs
